/* pages/add/add.wxss */
.container {
  padding: 20rpx;
  padding-bottom: 120rpx;
}

.label {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 20rpx;
}

.hint {
  font-size: 24rpx;
  color: #bbb;
  font-weight: normal;
}

/* 金额输入 */
.amount-card {
  text-align: center;
  padding: 40rpx 30rpx;
}

.amount-input-row {
  display: flex;
  align-items: center;
  justify-content: center;
}

.currency {
  font-size: 52rpx;
  font-weight: bold;
  color: #333;
  margin-right: 10rpx;
}

.amount-input {
  font-size: 52rpx;
  line-height: 88rpx;
  font-weight: bold;
  color: #333;
  width: 300rpx;
  height: 88rpx;
  text-align: center;
  border-bottom: 4rpx solid #07c160;
  padding: 0;
  box-sizing: border-box;
}

.placeholder {
  color: #ddd;
  font-weight: normal;
}

/* 日期选择 */
.date-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  color: #333;
  font-size: 30rpx;
}

.date-arrow {
  color: #aaa;
  font-size: 36rpx;
}

/* 类别网格 */
.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.cat-item {
  padding: 16rpx 28rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  font-size: 28rpx;
  color: #666;
  transition: all 0.2s;
}

.cat-active {
  background: #07c160;
  color: #fff;
  font-weight: bold;
}

/* 付款人 */
.spender-row {
  display: flex;
  gap: 20rpx;
}

.spender-item {
  flex: 1;
  text-align: center;
  padding: 24rpx;
  border-radius: 14rpx;
  background: #f5f5f5;
  font-size: 30rpx;
  color: #666;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.member-icon {
  display: block;
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  margin: 0 auto 10rpx;
  border-radius: 50%;
  background: #fff;
  font-size: 30rpx;
}

.spender-active {
  background: #e8f8f0;
  border-color: #07c160;
  color: #07c160;
  font-weight: bold;
}

/* 备注输入 */
.note-input {
  width: 100%;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 10rpx;
  font-size: 28rpx;
}

/* 提交 */
.submit-area {
  position: fixed;
  bottom: 40rpx;
  left: 0;
  right: 0;
  padding: 0 40rpx;
}

.btn-submit {
  width: 100%;
  background: #07c160;
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
  border-radius: 46rpx;
  padding: 28rpx 0;
  border: none;
  box-shadow: 0 4rpx 20rpx rgba(7, 193, 96, 0.35);
}

.btn-submit[disabled] {
  background: #a0d9b8;
  box-shadow: none;
}

.btn-submit::after {
  border: none;
}
