<!--pages/index/index.wxml 首页-->
<view class="container">

  <!-- 顶部总金额卡片 -->
  <view class="header-card">
    <view class="current-user" wx:if="{{currentUser}}">
      <text>{{currentUser.icon}} 当前记录人：{{currentUser.memberName}}</text>
    </view>
    <text class="header-label">家庭总支出（本月）</text>
    <text class="header-amount">¥{{totalAmount}}</text>
    <view class="member-row">
      <view class="member-item" wx:for="{{memberSummary}}" wx:key="name">
        <text class="member-icon">{{item.icon}}</text>
        <text class="member-name">{{item.name}}</text>
        <text class="member-amount">¥{{item.amount}}</text>
        <text class="member-percent">{{item.percent}}%</text>
      </view>
    </view>
  </view>

  <!-- 账单列表 -->
  <view class="bill-list">
    <view class="bill-title">最近账单</view>
    <view class="bill-swipe-item" wx:for="{{bills}}" wx:key="_id">
      <view
        class="bill-item {{swipedBillId === item._id ? 'bill-item-open' : ''}}"
        data-id="{{item._id}}"
        bindtouchstart="onBillTouchStart"
        bindtouchend="onBillTouchEnd"
        bindtap="closeSwipe"
      >
        <view class="bill-left">
          <view class="bill-category tag {{item.tagClass}}">{{item.category}}</view>
          <text class="bill-note">{{item.note || '无备注'}}</text>
        </view>
        <view class="bill-right">
          <text class="bill-amount">-¥{{item.amount}}</text>
          <text class="bill-spender">{{item.spenderIcon}} {{item.spender}} · {{item.dateStr}}</text>
          <text class="bill-creator">{{item.createdByIcon}} {{item.createdByName}} 添加</text>
        </view>
      </view>
      <view
        class="bill-delete-action"
        data-id="{{item._id}}"
        data-note="{{item.note}}"
        data-amount="{{item.amount}}"
        catchtap="deleteBill"
      >
        <text>删除</text>
      </view>
    </view>
    <view class="delete-hint" wx:if="{{bills.length > 0}}">
      <text>向左滑动删除，向右滑动修改</text>
    </view>
    <view wx:if="{{bills.length === 0}}" class="empty-tip">
      <text>还没有账单，快去记一笔吧~</text>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-bar">
    <button class="btn-bottom btn-stats" bindtap="goStats">📊 统计</button>
    <button class="btn-bottom btn-add" bindtap="goAdd">+ 记一笔</button>
  </view>

  <view class="identity-mask" wx:if="{{showIdentityModal}}">
    <view class="identity-panel">
      <text class="identity-title">选择使用者</text>
      <text class="identity-desc">首次使用需要绑定身份，之后会自动记录是谁添加了账单。</text>
      <view class="identity-options">
        <view
          class="identity-option"
          wx:for="{{operatorOptions}}"
          wx:key="name"
          data-name="{{item.name}}"
          bindtap="selectIdentity"
        >
          <text class="identity-icon">{{item.icon}}</text>
          <text>{{item.name}}</text>
        </view>
      </view>
    </view>
  </view>

</view>
