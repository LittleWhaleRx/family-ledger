/* pages/index/index.wxss */
.container {
  padding-bottom: 120rpx;
}

/* 顶部卡片 */
.header-card {
  background: linear-gradient(135deg, #07c160, #05a84d);
  margin: 20rpx;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  color: #fff;
}

.header-label {
  font-size: 26rpx;
  opacity: 0.85;
  display: block;
  margin-bottom: 10rpx;
}

.header-amount {
  font-size: 64rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 30rpx;
}

.member-row {
  display: flex;
  justify-content: space-around;
}

.member-item {
  text-align: center;
}

.member-icon {
  display: block;
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  margin: 0 auto 8rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.18);
  font-size: 30rpx;
}

.member-name {
  font-size: 24rpx;
  opacity: 0.8;
  display: block;
  margin-bottom: 4rpx;
}

.member-amount {
  font-size: 32rpx;
  font-weight: bold;
}

/* 账单列表 */
.bill-list {
  margin: 0 20rpx;
}

.bill-title {
  font-size: 30rpx;
  font-weight: bold;
  padding: 20rpx 10rpx;
}

.bill-swipe-item {
  position: relative;
  overflow: hidden;
  border-radius: 14rpx;
  margin-bottom: 16rpx;
}

.bill-item {
  position: relative;
  z-index: 1;
  background: #fff;
  border-radius: 14rpx;
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: transform 0.2s ease;
}

.bill-item-open {
  transform: translateX(-128rpx);
}

.bill-delete-action {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e74c3c;
  color: #fff;
  font-size: 26rpx;
  font-weight: bold;
  z-index: 0;
}

.bill-left {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
  margin-right: 20rpx;
}

.bill-category {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  margin-bottom: 8rpx;
  align-self: flex-start;
}

.bill-note {
  font-size: 28rpx;
  color: #333;
  word-break: break-all;
}

.bill-right {
  text-align: right;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.bill-amount {
  font-size: 34rpx;
  font-weight: bold;
  color: #e74c3c;
  display: block;
}

.bill-spender {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.delete-hint {
  text-align: center;
  color: #bbb;
  font-size: 22rpx;
  padding: 8rpx 0 20rpx;
}

/* 各类别标签颜色 */
.tag-food { background: #fff0e6; color: #e67e22; }
.tag-transport { background: #e8f4fd; color: #2980b9; }
.tag-shopping { background: #fde8f0; color: #c0392b; }
.tag-housing { background: #e8f8f0; color: #27ae60; }
.tag-entertain { background: #f3e8fd; color: #8e44ad; }
.tag-medical { background: #fde8e8; color: #e74c3c; }
.tag-education { background: #e8f0fd; color: #2c3e50; }
.tag-other { background: #f0f0f0; color: #666; }

/* 空状态 */
.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 底部按钮 */
.bottom-bar {
  position: fixed;
  bottom: 40rpx;
  left: 0;
  right: 0;
  padding: 0 40rpx;
  display: flex;
  gap: 20rpx;
}

.btn-bottom {
  flex: 1;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 46rpx;
  padding: 28rpx 0;
  border: none;
}

.btn-bottom::after {
  border: none;
}

.btn-add {
  background: #07c160;
  box-shadow: 0 4rpx 20rpx rgba(7, 193, 96, 0.35);
}

.btn-stats {
  background: #fff;
  color: #07c160;
  border: 2rpx solid #07c160;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.06);
}
