<!--pages/stats/stats.wxml 统计-->
<view class="container">

  <!-- 月度切换 -->
  <view class="month-bar">
    <text class="month-arrow" bindtap="prevMonth">‹</text>
    <text class="month-text">{{year}}年{{month}}月</text>
    <text class="month-arrow" bindtap="nextMonth">›</text>
  </view>

  <!-- 总金额 -->
  <view class="total-card">
    <text class="total-label">本月支出</text>
    <text class="total-amount">¥{{totalAmount}}</text>
  </view>

  <!-- 成员统计 -->
  <view class="member-card" wx:if="{{memberData.length > 0}}">
    <view class="section-title">成员支出</view>
    <view class="member-stat" wx:for="{{memberData}}" wx:key="name">
      <view class="member-header">
        <text class="member-name">{{item.name}}</text>
        <text class="member-amount">¥{{item.amount}}</text>
      </view>
      <view class="member-meta">
        <text>{{item.count}}笔</text>
        <text>占比 {{item.percent}}%</text>
        <text>均笔 ¥{{item.avgAmount}}</text>
      </view>
      <view class="member-progress">
        <view class="member-progress-fill" style="width: {{item.percent}}%"></view>
      </view>
      <view class="member-structure" wx:if="{{item.categories.length > 0}}">
        <canvas
          type="2d"
          class="member-pie-canvas"
          data-member-index="{{index}}"
        ></canvas>
        <view class="member-category-list">
          <view class="member-category-item" wx:for="{{item.categories}}" wx:for-item="cat" wx:key="name">
            <view class="member-category-dot" style="background: {{cat.color}}"></view>
            <text class="member-category-name">{{cat.name}}</text>
            <text class="member-category-pct">{{cat.percent}}%</text>
            <text class="member-category-amount">¥{{cat.amount}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 饼图区域 -->
  <view class="chart-card" wx:if="{{categoryData.length > 0}}">
    <view class="section-title">类别支出</view>
    <canvas type="2d" id="pieChart" class="pie-canvas"></canvas>
    <!-- 图例 -->
    <view class="legend-list">
      <view class="legend-item" wx:for="{{categoryData}}" wx:key="name">
        <view class="legend-dot" style="background: {{item.color}}"></view>
        <text class="legend-name">{{item.name}}</text>
        <text class="legend-pct">{{item.percent}}%</text>
        <text class="legend-amount">¥{{item.amount}}</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{categoryData.length === 0}}" class="empty-tip">
    <text>本月还没有支出记录</text>
  </view>

</view>
