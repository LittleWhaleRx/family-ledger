/* pages/stats/stats.wxss */
.container {
  padding: 20rpx;
  padding-bottom: 60rpx;
}

/* 月份切换 */
.month-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
}

.month-arrow {
  font-size: 44rpx;
  color: #07c160;
  padding: 0 40rpx;
  font-weight: bold;
}

.month-text {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

/* 总金额卡片 */
.total-card {
  background: linear-gradient(135deg, #07c160, #05a84d);
  border-radius: 20rpx;
  padding: 40rpx;
  text-align: center;
  margin-bottom: 30rpx;
}

.total-label {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
  display: block;
  margin-bottom: 8rpx;
}

.total-amount {
  font-size: 56rpx;
  font-weight: bold;
  color: #fff;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 22rpx;
}

/* 成员统计 */
.member-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.member-stat {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.member-stat:last-child {
  border-bottom: none;
}

.member-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.member-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.member-amount {
  font-size: 32rpx;
  font-weight: bold;
  color: #e74c3c;
}

.member-meta {
  display: flex;
  justify-content: space-between;
  color: #888;
  font-size: 22rpx;
  margin-bottom: 14rpx;
}

.member-progress {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
}

.member-progress-fill {
  height: 100%;
  background: #07c160;
  border-radius: 6rpx;
}

/* 图表卡片 */
.chart-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.pie-canvas {
  width: 400rpx;
  height: 400rpx;
  margin: 0 auto;
  display: block;
}

/* 图例 */
.legend-list {
  margin-top: 30rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.legend-name {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.legend-pct {
  font-size: 24rpx;
  color: #999;
  margin-right: 16rpx;
}

.legend-amount {
  font-size: 28rpx;
  font-weight: bold;
  color: #e74c3c;
}

/* 空状态 */
.empty-tip {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}
